{
  "action_requirements": {
    "create": {
      "allow": [
        {
          "match": "prefix",
          "value": "generated/"
        }
      ],
      "deny": [
        {
          "match": "prefix",
          "value": "generated/private/"
        }
      ],
      "required_role": null
    },
    "modify": {
      "allow": [
        {
          "match": "exact",
          "value": "README.md"
        }
      ],
      "deny": [],
      "required_role": "repository-maintainer"
    }
  },
  "contract_id": "repository-file-policy",
  "contract_version": "2.0.0",
  "schema_version": "action_policy.v1"
}
