{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://waveframelabs.org/schemas/action_policy.v1.json",
  "title": "Action policy v1",
  "type": "object",
  "required": [
    "schema_version",
    "contract_id",
    "contract_version",
    "action_requirements"
  ],
  "properties": {
    "schema_version": {
      "const": "action_policy.v1"
    },
    "contract_id": {
      "type": "string",
      "minLength": 1
    },
    "contract_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "not": {
        "pattern": "[^0-9.]"
      }
    },
    "action_requirements": {
      "type": "object",
      "minProperties": 1,
      "properties": {
        "create": {
          "$ref": "#/$defs/action"
        },
        "modify": {
          "$ref": "#/$defs/action"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "rule": {
      "type": "object",
      "required": [
        "match",
        "value"
      ],
      "properties": {
        "match": {
          "type": "string",
          "enum": [
            "exact",
            "prefix"
          ]
        },
        "value": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "action": {
      "type": "object",
      "description": "No matching allow means no permission. Deny takes precedence; required_role is an additional action-wide requirement. Identical allow/deny selectors are rejected by the compiler.",
      "required": [
        "required_role",
        "allow",
        "deny"
      ],
      "properties": {
        "required_role": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "allow": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/rule"
          },
          "uniqueItems": true
        },
        "deny": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/rule"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    }
  }
}
